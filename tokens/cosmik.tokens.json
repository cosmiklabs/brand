{
  "$description": "Cosmik 0.2.0 — PROPOSED. Generated by generate-tokens.mjs from cosmik.source.json; do not edit. Colour roles in \"color\" resolve to the default dark theme; each carries $extensions[\"com.cosmiklabs.modes\"] with its alias in every theme (dark, light). Tools without mode support see the dark theme.",
  "$extensions": {
    "com.cosmiklabs": {
      "name": "Cosmik",
      "version": "0.2.0",
      "status": "Proposed system; pending owner approval",
      "defaultMode": "dark",
      "modes": [
        "dark",
        "light"
      ],
      "proposals": [
        "Proposed — needs owner approval: status colours (red, amber, green and blue primitives; status-{error,warning,success,info}-{fg,bg,border} roles).",
        "Proposed — needs owner approval: light-theme counterparts for the website's dark-only greys (divider-strong, ornament, ornament-faint, ornament-text, media-placeholder), scrim and shadow alpha values, the radius scale and elevation levels."
      ]
    }
  },
