{
  "id": "hplx",
  "name": "HPLX",
  "extends": "Cosmik baseline 0.2.0",
  "version": "0.1.0",
  "status": "Proposed family; values pending owner review",
  "description": "The HPLX product family: the engine, its game reimplementations, the launcher and the editor. Warm blacks and bone text, a lantern-amber accent, Spectral for titles, and the status hues its tools need. Everything else comes from the Cosmik baseline, whose rules it keeps.",
  "proposals": [
    "Proposed — needs owner approval: every value in this family (palette, amber accent, Spectral titles, status hues, elevation)."
  ],
  "fonts": [
    {
      "family": "Spectral",
      "weights": [
        600
      ],
      "license": "SIL Open Font License 1.1",
      "license_file": "fonts/licenses/Spectral-OFL.txt",
      "source": "https://github.com/google/fonts/tree/main/ofl/spectral",
      "files": {
        "desktop": "fonts/desktop/Spectral-SemiBold.ttf",
        "web": "fonts/web/Spectral-SemiBold.woff2"
      }
    }
  ],
