      "surface": "raised",
      "offsetX": "0px",
      "offsetY": "1px",
      "blur": "2px",
      "spread": "0px",
      "color": "shadow"
    },
    "2": {
      "surface": "raised",
      "offsetX": "0px",
      "offsetY": "4px",
      "blur": "12px",
