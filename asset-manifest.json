{
  "name": "Cosmik brand kit",
  "version": "0.3.0",
  "date": "2026-10-08",
  "system_status": "baseline approved (owner, 2026-10-07); the HPLX family kit is proposed",
  "emblem_status": "accepted traced symbol",
  "wordmark_status": "approved raster only; outlined master not supplied",
  "interim_identity": "Official stand-in until an outlined wordmark exists: the emblem followed by the live label “Cosmik” in Inter 500 (type role identity-label, 20 px / 1.3, tracking 0). The label is a typographic treatment, not a wordmark; never set COSMIK in capitals with Inter to imitate the wordmark.",
  "license": "LICENSE.md",
  "known_gaps": [
    {
      "id": "wordmark-lockup",
      "status": "open",
      "summary": "No outlined COSMIK wordmark or vector horizontal lockup. Only the approved raster banner exists. Use the interim_identity stand-in."
    },
    {
      "id": "optical-small-icon",
      "status": "open",
      "summary": "No optically redrawn small-size emblem. The 16–64 px renders and the icons/ files are faithful reductions of the master geometry; the fine cut and isolated point lose definition at favicon sizes."
    },
    {
      "id": "print-proofs",
      "status": "open",
      "summary": "No print-process proofs."
    },
    {
      "id": "browser-qa",
      "status": "open",
      "summary": "Headless Chromium checks cover both kits; full browser zoom, other browser engines and assistive-technology checks remain pending. See references/component-validation.md."
    },
    {
      "id": "hplx-optical-small-icon",
      "status": "open",
      "summary": "Ember 16–32 px exports are faithful reductions, not an optical redesign; the upper arc and diamond lose definition at tiny sizes. No HPLX wordmark or splash composition is supplied."
    }
  ],
