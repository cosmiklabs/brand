{
  "name": "Cosmik brand kit",
  "version": "0.15.1",
  "date": "2026-10-25",
  "system_status": "baseline approved (owner, 2026-10-07). Product families are maintained in their own repositories (cosmiklabs/brand-hplx, cosmiklabs/brand-tectra) and build on a pinned release of this kit.",
  "emblem_status": "accepted traced symbol",
  "wordmark_status": "outlined trace of the approved banner (kits/cosmik/assets/vector/cosmik-lockup-*.svg), accepted (owner, 2026-10-11); the approved raster stays the reference",
  "interim_identity": "Small identity where the lockup would be too large: the emblem followed by the live label “Cosmik” in Inter 500 (type role identity-label, 20 px / 1.3, tracking 0). The label is a typographic treatment, not a wordmark; never set COSMIK in capitals with Inter to imitate the wordmark.",
  "license": "LICENSE.md",
  "known_gaps": [
    {
      "id": "optical-small-icon",
      "status": "open",
      "summary": "No optically redrawn small-size Cosmik emblem: the 16–64 px renders and kits/cosmik/icons/cosmik.* are faithful reductions of the master geometry, and the fine cut and isolated point lose definition at favicon sizes."
    },
    {
      "id": "print-proofs",
      "status": "open",
      "summary": "No print-process proofs."
    },
    {
      "id": "browser-qa",
      "status": "open",
      "summary": "Chromium checks cover the baseline reference, the shared controls layer and a test-only family scope. Full browser zoom, other browser engines and assistive-technology checks remain pending. See specimens/validation.md."
    }
  ],
